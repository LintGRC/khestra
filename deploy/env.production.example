# Khestra environment — copy to .env and fill in values.
#
# Domain Caddy serves (use a real domain for automatic TLS; `localhost`
# works for local evaluation with Caddy's local certificates).
DOMAIN=localhost

# Admin seeding. If CMMC_ADMIN_PASSWORD is unset, a strong random password is
# generated on first boot and written to a credentials file inside the
# container's shared auth volume.
# Generate one with: openssl rand -base64 24
# CMMC_ADMIN_PASSWORD=

# Auth posture. `local` enables email+password login with the shared auth DB
# (required for a usable self-host; unset means NO authentication).
# Entra ID is the recommended pre-GA option for public internet exposure.
CMMC_AUTH_MODE=local
# CMMC_ALLOWED_ORIGINS=https://app.yourdomain.com
# CMMC_AUTO_LOAD_DEMO=                 # leave unset in production

# Optional: mark this as a production host so the auth-posture guard applies
# (requires KHESTRA_TRUSTED_NETWORK=1 when running local auth).
# KHESTRA_ENV=production
# KHESTRA_TRUSTED_NETWORK=1
