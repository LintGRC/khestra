# Optional — AI polish for "Suggest SSP from evidence" (OpenAI-compatible API)
# Copy to .env in cmmc-saas/ and restart the API (./run-dev.sh)
# Production checklist: PRODUCTION.md
# Entra sign-in + RBAC: ENTRA_AUTH.md

# --- Microsoft Entra ID (optional — enables sign-in and locks role picker) ---
# CMMC_ENTRA_TENANT_ID=your-tenant-guid
# CMMC_ENTRA_CLIENT_ID=your-client-guid
# CMMC_ENTRA_AUTH_ENABLED=1
# CMMC_ENTRA_GROUP_ASSESSOR=security-group-object-id
# CMMC_ENTRA_GROUP_ENGINEER=security-group-object-id
# CMMC_ENTRA_GROUP_EXECUTIVE=security-group-object-id
# CMMC_ENTRA_GROUP_COMPLIANCE_MANAGER=security-group-object-id

OPENAI_API_KEY=sk-your-key-here

# Optional overrides
# CMMC_OPENAI_API_KEY=sk-...   # takes precedence over OPENAI_API_KEY
# CMMC_AI_MODEL=gpt-4o-mini
# CMMC_AI_DISABLE=1              # force template-only even when a key is set

# Precedence: stored in-app key (Integrations page) > CMMC_OPENAI_API_KEY >
# OPENAI_API_KEY > HOSTED_AI_KEY. The in-app key is encrypted at rest under
# the data dir and never returned by any API.
# HOSTED_AI_KEY=                 # platform-provided default on hosted plans;
#                                # injected at deployment — never commit a value
# Optional extra prompt rules (appended to Suggest SSP request)
# CMMC_AI_SSP_EXTRA_INSTRUCTIONS=Never claim FIPS validation unless explicitly in the evidence bundle.

# Optional global webhook token (scripts without per-collector registration)
# CMMC_WEBHOOK_TOKEN=your-long-random-token
# WEBHOOK_TOKEN=...   # alias accepted by the API

# Scheduled collector runs (cron / workers/run_due.py --api-url)
# CMMC_COLLECTOR_SCHEDULER_TOKEN=your-long-random-token

# Production hosting (see PRODUCTION.md)
# DEMO_MODE=0                         # default — blocks POST /api/demo/load and /api/demo/clear
# CMMC_ALLOWED_ORIGINS=https://app.yourdomain.com
# CMMC_ENTRA_AUTH_ENABLED=1           # required for public internet; locks role picker

# Optional dev-only in-process scheduler (do not use with multiple API replicas)
# COLLECTOR_SCHEDULER=1
# COLLECTOR_SCHEDULER_INTERVAL_MINUTES=60
# COLLECTOR_SCHEDULER_USE_FIXTURE=1
